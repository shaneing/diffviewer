{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeReviwer Diff Viewer",
  "version": "0.1.0",
  "identifier": "com.codereviwer.diffviewer",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeReviwer Diff Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
